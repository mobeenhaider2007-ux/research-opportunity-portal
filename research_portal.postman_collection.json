    {
      "name": "1. Create Opportunity 1 (Quantum Network Security)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response returns created opportunity object with ID', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.collectionVariables.set('createdId', jsonData.data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Quantum Network Protocol Design\",\n  \"description\": \"Investigating quantum key distribution (QKD) and repeater placement strategies in next-generation high-speed university backbones.\",\n  \"research_area\": \"Quantum Cryptography\",\n  \"faculty_name\": \"Dr. Aris Thorne\",\n  \"department\": \"Computer Science & Engineering\",\n  \"required_skills\": \"Python, C++, NS-3, Quantum Mechanics\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2026-11-15\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"]
        }
